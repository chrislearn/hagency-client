# Copy this file to `release-secrets.env` (same folder) and fill in the values,
# then run `./packaging/upload-release-secrets.sh`.
#
# `release-secrets.env` is gitignored. Blank entries are skipped on upload, so
# you can set up desktop signing first and add iOS later by re-running.
# Quote every value; use single quotes for anything containing `$` or spaces.

# Repo to upload the secrets to.
RELEASE_REPO='hagency-org/hagency-client'

# --- Windows update signing ---
# Generate once with: cargo packager signer generate --path rinx-updater.key
CARGO_PACKAGER_SIGN_PRIVATE_KEY_FILE='' # path to that key file
CARGO_PACKAGER_SIGN_PRIVATE_KEY_PASSWORD='' # the password you set for it
# Add the generated .pub content as the HAGENCY_UPDATER_PUBLIC_KEY repository variable.

# --- macOS signing + notarization ---
APPLE_CERTIFICATE_FILE=''               # path to your "Developer ID Application" .p12
APPLE_CERTIFICATE_PASSWORD=''           # the .p12 export password
APPLE_ID=''                             # your Apple ID email
APPLE_PASSWORD=''                       # app-specific password from appleid.apple.com
APPLE_TEAM_ID=''                        # Your own Apple Developer team
APPLE_SIGNING_IDENTITY=''               # full Developer ID Application identity (repository variable)
MACOS_SIGNED_RELEASE=''                 # set 'true' only after the signing configuration is ready

# --- Independent macOS Sparkle signing ---
# Export with the pinned SDK's generate_keys --account hagency-client -x <file>.
# This is a different key/format from the Windows updater signing key above.
HAGENCY_SPARKLE_PRIVATE_KEY_FILE=''      # protected base64 Sparkle private seed file
HAGENCY_SPARKLE_PUBLIC_KEY=''            # public Ed25519 key only (repository variable)

# --- iOS (optional; leave blank to skip) ---
APP_STORE_CONNECT_API_KEY_FILE=''       # path to AuthKey_XXXXXX.p8
APP_STORE_CONNECT_KEY_ID=''             # the key's ID
APP_STORE_CONNECT_ISSUER_ID=''          # issuer UUID from App Store Connect
APPLE_PROVISIONING_PROFILE_FILE=''      # path to your .mobileprovision
APPLE_KEYCHAIN_PASSWORD=''              # any random string (temp keychain password)

# --- Release token (optional; configure for this repository when needed) ---
RINX_RELEASE=''                       # PAT with contents:write, only if not already set
