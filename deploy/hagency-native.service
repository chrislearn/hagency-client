# Reference per-user OwnerHost unit. Use `hagency service install` to generate
# escaped paths and PATH for the installing user; never install as a system unit.
[Unit]
Description=Hagency owner client
After=network.target
[Service]
Type=simple
WorkingDirectory=__STATE_DIR__
ExecStart=__INSTALL_DIR__/hagency start --no-open --state-dir __STATE_DIR__ --listen 127.0.0.1:13300
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
[Install]
WantedBy=default.target
