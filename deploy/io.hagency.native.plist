<?xml version="1.0" encoding="UTF-8"?>
<!-- Reference per-user OwnerHost LaunchAgent. `hagency service install` generates
     escaped paths, logs and PATH. Agents require explicit authenticated start. -->
<plist version="1.0"><dict>
<key>Label</key><string>io.hagency</string>
<key>ProgramArguments</key><array>
<string>__INSTALL_DIR__/hagency</string><string>start</string><string>--no-open</string>
<string>--state-dir</string><string>__STATE_DIR__</string>
<string>--listen</string><string>127.0.0.1:13300</string>
</array>
<key>WorkingDirectory</key><string>__STATE_DIR__</string>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
<key>ThrottleInterval</key><integer>5</integer>
</dict></plist>
